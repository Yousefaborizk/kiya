# =====================================================
# Edge Functions Environment
# =====================================================
# Copy this file to `.env.local` (local dev) and fill the values.
# For production: `supabase secrets set KEY=value`
# =====================================================

# ── Supabase (auto-injected in production, set manually for local) ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ── AI Providers (at least one required) ─────────────
# Cerebras: https://cloud.cerebras.ai/  → API Keys
CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxx

# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_AI_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Search (optional) ────────────────────────────────
# If not set, public SearXNG instances are used (may be rate-limited).
# Recommended for production:
# SEARXNG_URL=https://your-searxng-instance.com